# ── Core ──────────────────────────────────────────────
DATABASE_URL=postgres://viralchat:viralchat@localhost:5432/viralchat
# Public base URL (used for OAuth redirects, Stripe return URLs, webhooks)
APP_URL=http://localhost:3000
# 32 random bytes, base64. Encrypts OAuth tokens / API keys at rest.  openssl rand -base64 32
ENCRYPTION_KEY=
# Shared secret for the scheduled job endpoint (/api/cron/automations)
CRON_SECRET=

# ── Meta (Instagram + Facebook Messenger) ─────────────
# Create an app at https://developers.facebook.com/apps (type: Business)
# Products: Facebook Login for Business, Messenger, Instagram (Instagram API with Facebook Login)
# YouTube comment replies (Google Cloud OAuth client, YouTube Data API v3)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

META_APP_ID=
META_APP_SECRET=
# Optional: Facebook Login for Business configuration id (used instead of scopes when set)
META_LOGIN_CONFIG_ID=
# Any random string; paste the same value into the Meta webhook "Verify token" field
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0

# ── OpenAI (AI chatbot) ───────────────────────────────
# Workspaces can also add their own key on the Integrations page
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# ── Stripe Billing ────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_AGENCY=

# Public contact email shown on /privacy, /terms and /data-deletion (required for Meta App Review)
SUPPORT_EMAIL=
